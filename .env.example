# Copy to .env for local work. Every value here is a placeholder; none is a credential.
#
# The core pipeline — spec diff, call-site generation, compiler oracle, classification,
# evaluation — requires NO credential of any kind and makes no network call at run time.

# local | ci | staging | production
CSI_ENVIRONMENT=local

# Fail-closed. Empty means no browser origin may call the API directly.
CSI_CORS_ALLOW_ORIGINS=[]

# --- Optional explanation layer (NOT part of the measured claim) -------------------------
# Names only. The shipped classification path takes no model client and a guard test enforces it.
# CSI_LIVE_EXPLAIN=1
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
